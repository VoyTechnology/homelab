out.txt

# Ignore AI generated stuff
.crush/

# Ignore jsonnet files
vendor/
spec.json
# Flux apps are real Tanka environments; their spec.json is committed.
!apps/**/spec.json

# Ignore downloaded Helm chart dependency archives (`helm dependency
# update`/`build` populate argo/apps/*/charts/ with these; they're
# reproducible from Chart.lock, not something to commit)
charts/*.tgz

# Helm charts vendored for Flux apps by `tk tool charts vendor` (pinned in chartfile.yaml)
apps/*/charts/
