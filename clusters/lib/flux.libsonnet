// Flux bootstrap sync config for a cluster. Returns the files to render
// (gotk-sync.yaml, kustomization.yaml) and the Flux version that
// scripts/render-flux.sh exports gotk-components.yaml for.
local flux = import 'github.com/jsonnet-libs/fluxcd-libsonnet/2.9.4/main.libsonnet';
local git = flux.source.v1.gitRepository;
local ks = flux.kustomize.v1.kustomization;

{
  new(
    cluster,
    repo='ssh://git@github.com/VoyTechnology/homelab-manifests',
    branch='main',
    namespace='flux-system',
    path='./clusters/' + cluster,
    secretName='flux-system',
    // renovate: datasource=github-releases depName=fluxcd/flux2
    version='v2.10.0',
  ):: {
    // Hidden: read by scripts/render-flux.sh to export gotk-components.yaml.
    version:: version,

    local sync = [
      git.new('flux-system')
      + git.metadata.withNamespace(namespace)
      + git.spec.withInterval('1m0s')
      + git.spec.ref.withBranch(branch)
      + git.spec.secretRef.withName(secretName)
      + git.spec.withUrl(repo),

      ks.new('flux-system')
      + ks.metadata.withNamespace(namespace)
      + ks.spec.withInterval('10m0s')
      + ks.spec.withPath(path)
      + ks.spec.withPrune(true)
      + ks.spec.sourceRef.withKind('GitRepository')
      + ks.spec.sourceRef.withName('flux-system'),
    ],

    'gotk-sync.yaml': '# This manifest was generated by flux. DO NOT EDIT.\n'
                      + std.manifestYamlStream(sync, quote_keys=false, c_document_end=false),

    // Static: yq would indent the list, flux does not. -S adds the final newline.
    'kustomization.yaml': std.rstripChars(|||
      apiVersion: kustomize.config.k8s.io/v1beta1
      kind: Kustomization
      resources:
      - gotk-components.yaml
      - gotk-sync.yaml
    |||, '\n'),
  },
}
